# skill-mcp holds no credentials of its own. It reads a directory of skills and
# runs the scripts a skill declares AND the owner granted — so everything below
# is configuration, not a secret, and none of it belongs in a secret store.

# Where the skills are. Colon-separated; the first match wins on a name clash,
# except that a name in two roots is refused rather than resolved.
# Defaults to the example skill bundled with this package.
# SKILLS_DIR=~/my-skills

# --- Set by a host, not by you -----------------------------------------------
# These are injected when this server runs under mcp-host. Their PRESENCE is
# what tells the adapter it is hosted, which flips the default grant closed:
# standalone, a skill's own declaration stands (you are the owner, at your own
# terminal); hosted, nothing runs unless the registration granted it.
#
# MCP_SKILLS_PATH   the roots, as the runner mounted them
# MCP_SKILL_RUN     the owner's grant: [{skill, script, env?}], JSON.
#                   It can only ever NARROW what a skill declared.
# MCP_DATA_DIR      the registration's persistent scratch directory
# MCP_HOST_METER_FILE / MCP_BLOB_BASE_URL   host plumbing
