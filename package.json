{
  "name": "@chrischall/skill-mcp",
  "version": "0.2.1",
  "mcpName": "io.github.chrischall/skill-mcp",
  "description": "Serves a directory of Agent Skills as an MCP server — developed and maintained by AI (Claude Code)",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/skill-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "agent-skills",
    "skills",
    "skill",
    "adapter"
  ],
  "type": "module",
  "bin": {
    "skill-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills/",
    ".mcp.json",
    "server.json",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --banner:js=\"import{createRequire as __nodeCreateRequire}from'node:module';const require=__nodeCreateRequire(import.meta.url);\" --outfile=dist/bundle.js",
    "dev": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^0.28.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
